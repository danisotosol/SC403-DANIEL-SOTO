              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "prestamos",
                "atrasados"
              ]
            },
            "description": "Endpoint clave del caso. Detras corre la JPQL propia: fechaDevolucionReal IS NULL AND fechaDevolucionEsperada < :hoy, con JOIN FETCH de libro y usuario para evitar N+1. Con el seed cargado devuelve 2 filas."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('200 y lista de atrasados', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(data).to.be.an('array');",
                  "});",
                  "pm.test('todos tienen diasAtraso > 0 y sin fecha real', function () {",
                  "  data.forEach(p => {",
                  "    pm.expect(p.fechaDevolucionReal).to.be.null;",
                  "    pm.expect(p.diasAtraso).to.be.above(0);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
