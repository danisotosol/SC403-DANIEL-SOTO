                "login"
              ]
            },
            "description": "Credenciales de un lector. Sirve para demostrar el 403 en los endpoints de escritura.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"lector\",\n  \"password\": \"lector123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
